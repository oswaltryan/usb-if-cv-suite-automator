# .gitignore

# Python
# -------------------------------------------------------------------
# Byte-compiled / optimized / C-extensions
__pycache__/
*.pyc
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
# -------------------------------------------------------------------
# The 'venv' folder contains the isolated Python environment and all
# installed packages. It should never be tracked in Git.
venv/
env/
.venv/
.env/
.python-version
.virtualenv/


# Testing
# -------------------------------------------------------------------
# Test reports and coverage data
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
htmlcov/


# IDE / Editor Configuration
# -------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace


# OS-generated files
# -------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*


# Project-specific Files
# -------------------------------------------------------------------
# Temporary flag file created by the orchestration scripts to manage
# state across reboots. This is a runtime artifact, not source code.
test_in_progress.flag
